/* Q27. Simulate the UNIX 'ls' command (with optional -l style details) */
#include <stdio.h>
#include <string.h>
#include <dirent.h>
#include <sys/types.h>
#include <sys/stat.h>

int main(int argc, char *argv[]) {
    char path[256] = ".";
    char full[600];
    DIR *dir;
    struct dirent *entry;
    struct stat st;
    int count = 0;

    /* Optional: pass a directory name as argument, e.g.  ./q27 /home  */
    if (argc > 1) {
        strncpy(path, argv[1], sizeof(path) - 1);
        path[sizeof(path) - 1] = '\0';
    }

    dir = opendir(path);
    if (dir == NULL) {
        perror("opendir");
        return 1;
    }

    printf("Contents of directory '%s':\n\n", path);
    printf("%-6s %10s  %s\n", "TYPE", "SIZE", "NAME");
    while ((entry = readdir(dir)) != NULL) {
        if (entry->d_name[0] == '.')      /* skip hidden files like ls */
            continue;
        snprintf(full, sizeof(full), "%s/%s", path, entry->d_name);
        if (stat(full, &st) == 0) {
            printf("%-6s %10ld  %s\n",
                   S_ISDIR(st.st_mode) ? "DIR" : "FILE",
                   (long)st.st_size, entry->d_name);
        } else {
            printf("%-6s %10s  %s\n", "?", "?", entry->d_name);
        }
        count++;
    }
    closedir(dir);
    printf("\nTotal entries: %d\n", count);
    return 0;
}
