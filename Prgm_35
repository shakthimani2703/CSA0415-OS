/* Q35. Indexed file allocation:
   all block pointers of a file are kept together in an index block;
   the i-th entry of the index block points to the i-th block of the file. */
#include <stdio.h>

#define DISK_SIZE 50

int disk[DISK_SIZE];          /* 0 = free, 1 = allocated */

int main(void) {
    int indexBlock, n, i, b, index[DISK_SIZE], ok, choice;

    do {
        printf("\nEnter index block number (0-%d): ", DISK_SIZE - 1);
        scanf("%d", &indexBlock);
        if (indexBlock < 0 || indexBlock >= DISK_SIZE || disk[indexBlock]) {
            printf("Block %d is invalid or already allocated.\n", indexBlock);
        } else {
            printf("Enter number of blocks needed for the file: ");
            scanf("%d", &n);
            ok = 1;
            printf("Enter the %d block numbers: ", n);
            for (i = 0; i < n; i++) {
                scanf("%d", &index[i]);
                if (index[i] < 0 || index[i] >= DISK_SIZE ||
                    disk[index[i]] || index[i] == indexBlock)
                    ok = 0;
            }
            /* check duplicates among requested blocks */
            for (i = 0; i < n && ok; i++)
                for (b = i + 1; b < n; b++)
                    if (index[i] == index[b]) ok = 0;

            if (!ok) {
                printf("One or more blocks are invalid or already allocated. File not created.\n");
            } else {
                disk[indexBlock] = 1;
                for (i = 0; i < n; i++) disk[index[i]] = 1;
                printf("\nFile allocated. Index block = %d\n", indexBlock);
                printf("Index entry -> Disk block\n");
                for (i = 0; i < n; i++)
                    printf("   %d        ->   %d\n", i, index[i]);
            }
        }
        printf("\nAllocate another file? (1 = Yes, 0 = No): ");
        scanf("%d", &choice);
    } while (choice == 1);

    return 0;
}
