/* Q37. FCFS (First Come First Served) disk scheduling */
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int n, i, head, req[50], total = 0, move;

    printf("Enter number of requests: ");
    scanf("%d", &n);
    printf("Enter the request queue: ");
    for (i = 0; i < n; i++) scanf("%d", &req[i]);
    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("\nFrom\tTo\tSeek\n");
    for (i = 0; i < n; i++) {
        move = abs(req[i] - head);
        printf("%d\t%d\t%d\n", head, req[i], move);
        total += move;
        head = req[i];
    }

    printf("\nTotal head movement (seek time) = %d\n", total);
    printf("Average seek time = %.2f\n", (float)total / n);
    return 0;
}
