/* Q24. UNIX system calls for file management: creat, open, write, read, close, unlink */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/stat.h>

int main(void) {
    int fd;
    char buffer[100];
    const char *msg = "Hello, World!\nThis is UNIX file management.\n";
    ssize_t bytesRead;

    /* 1. Create a new file */
    fd = creat("sample.txt", S_IRUSR | S_IWUSR);
    if (fd == -1) { perror("creat"); exit(1); }
    printf("File 'sample.txt' created successfully.\n");
    close(fd);

    /* 2. Open for writing and write data */
    fd = open("sample.txt", O_WRONLY | O_APPEND);
    if (fd == -1) { perror("open"); exit(1); }
    printf("File 'sample.txt' opened for writing.\n");
    if (write(fd, msg, strlen(msg)) == -1) { perror("write"); exit(1); }
    printf("Data written to 'sample.txt'.\n");
    close(fd);

    /* 3. Open for reading and read data */
    fd = open("sample.txt", O_RDONLY);
    if (fd == -1) { perror("open"); exit(1); }
    printf("File 'sample.txt' opened for reading.\n");
    bytesRead = read(fd, buffer, sizeof(buffer) - 1);
    if (bytesRead == -1) { perror("read"); exit(1); }
    buffer[bytesRead] = '\0';
    printf("Data read from 'sample.txt':\n%s", buffer);
    close(fd);

    /* 4. Delete the file */
    if (unlink("sample.txt") == -1) { perror("unlink"); exit(1); }
    printf("File 'sample.txt' deleted.\n");

    return 0;
}
