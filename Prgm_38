/* Q38. SCAN (elevator) disk scheduling
   Head moves toward one end servicing requests, goes all the way to the
   end of the disk, then reverses and services the remaining requests. */
#include <stdio.h>
#include <stdlib.h>

void sort(int a[], int n) {
    int i, j, t;
    for (i = 0; i < n - 1; i++)
        for (j = 0; j < n - i - 1; j++)
            if (a[j] > a[j + 1]) { t = a[j]; a[j] = a[j + 1]; a[j + 1] = t; }
}

int main(void) {
    int n, i, head, size, dir, req[50], total = 0, cur, idx;

    printf("Enter number of requests: ");
    scanf("%d", &n);
    printf("Enter the request queue: ");
    for (i = 0; i < n; i++) scanf("%d", &req[i]);
    printf("Enter initial head position: ");
    scanf("%d", &head);
    printf("Enter disk size (e.g. 200 for cylinders 0-199): ");
    scanf("%d", &size);
    printf("Enter direction (1 = towards higher, 0 = towards lower): ");
    scanf("%d", &dir);

    sort(req, n);

    /* idx = first request >= head */
    idx = 0;
    while (idx < n && req[idx] < head) idx++;

    cur = head;
    printf("\nSeek sequence: %d", head);

    if (dir == 1) {
        for (i = idx; i < n; i++) {
            total += abs(req[i] - cur); cur = req[i];
            printf(" -> %d", cur);
        }
        if (idx > 0) {                         /* go to end, then reverse */
            total += abs((size - 1) - cur); cur = size - 1;
            printf(" -> %d", cur);
            for (i = idx - 1; i >= 0; i--) {
                total += abs(req[i] - cur); cur = req[i];
                printf(" -> %d", cur);
            }
        }
    } else {
        for (i = idx - 1; i >= 0; i--) {
            total += abs(req[i] - cur); cur = req[i];
            printf(" -> %d", cur);
        }
        if (idx < n) {                         /* go to 0, then reverse */
            total += abs(cur - 0); cur = 0;
            printf(" -> %d", cur);
            for (i = idx; i < n; i++) {
                total += abs(req[i] - cur); cur = req[i];
                printf(" -> %d", cur);
            }
        }
    }

    printf("\n\nTotal head movement (seek time) = %d\n", total);
    printf("Average seek time = %.2f\n", (float)total / n);
    return 0;
}
