/* Q40. File access permissions and the different types of users in Linux
   (Owner / User, Group, Others  x  Read, Write, Execute) */
#include <stdio.h>
#include <stdlib.h>
#include <sys/types.h>
#include <sys/stat.h>

void showPermissions(const char *file) {
    struct stat st;
    char p[11];

    if (stat(file, &st) == -1) { perror("stat"); exit(1); }

    p[0] = S_ISDIR(st.st_mode) ? 'd' : '-';
    p[1] = (st.st_mode & S_IRUSR) ? 'r' : '-';
    p[2] = (st.st_mode & S_IWUSR) ? 'w' : '-';
    p[3] = (st.st_mode & S_IXUSR) ? 'x' : '-';
    p[4] = (st.st_mode & S_IRGRP) ? 'r' : '-';
    p[5] = (st.st_mode & S_IWGRP) ? 'w' : '-';
    p[6] = (st.st_mode & S_IXGRP) ? 'x' : '-';
    p[7] = (st.st_mode & S_IROTH) ? 'r' : '-';
    p[8] = (st.st_mode & S_IWOTH) ? 'w' : '-';
    p[9] = (st.st_mode & S_IXOTH) ? 'x' : '-';
    p[10] = '\0';

    printf("Permissions of %s : %s  (octal %o)\n", file, p, (unsigned)(st.st_mode & 0777));
    printf("  Owner  : %s%s%s\n", (st.st_mode & S_IRUSR) ? "Read " : "",
           (st.st_mode & S_IWUSR) ? "Write " : "", (st.st_mode & S_IXUSR) ? "Execute" : "");
    printf("  Group  : %s%s%s\n", (st.st_mode & S_IRGRP) ? "Read " : "",
           (st.st_mode & S_IWGRP) ? "Write " : "", (st.st_mode & S_IXGRP) ? "Execute" : "");
    printf("  Others : %s%s%s\n\n", (st.st_mode & S_IROTH) ? "Read " : "",
           (st.st_mode & S_IWOTH) ? "Write " : "", (st.st_mode & S_IXOTH) ? "Execute" : "");
}

int main(void) {
    const char *file = "file.txt";
    FILE *fp;

    /* create a test file */
    fp = fopen(file, "w");
    if (fp == NULL) { perror("fopen"); return 1; }
    fprintf(fp, "Permission demo\n");
    fclose(fp);

    printf("Types of users: Owner (u), Group (g), Others (o)\n");
    printf("Types of permissions: Read (r=4), Write (w=2), Execute (x=1)\n\n");

    /* rw-r--r--  (644) */
    chmod(file, S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH);
    printf("After chmod 644:\n");
    showPermissions(file);

    /* rw-rw-r--  (664) : give group write permission (like chmod g+w) */
    chmod(file, S_IRUSR | S_IWUSR | S_IRGRP | S_IWGRP | S_IROTH);
    printf("After chmod 664 (group gets write):\n");
    showPermissions(file);

    /* rwxr-x--x  (751) */
    chmod(file, S_IRWXU | S_IRGRP | S_IXGRP | S_IXOTH);
    printf("After chmod 751:\n");
    showPermissions(file);

    /* rwx------  (700) : only owner */
    chmod(file, S_IRWXU);
    printf("After chmod 700 (owner only):\n");
    showPermissions(file);

    remove(file);
    return 0;
}
