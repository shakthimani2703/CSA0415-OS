/* Q25. UNIX I/O system calls: fcntl, lseek, stat, opendir, readdir */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <dirent.h>
#include <sys/types.h>
#include <sys/stat.h>

int main(void) {
    int fd, flags;
    char buf[50];
    ssize_t n;
    struct stat st;
    DIR *dir;
    struct dirent *entry;
    const char *text = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

    /* Create a file and write some data */
    fd = open("test.txt", O_RDWR | O_CREAT | O_TRUNC, 0644);
    if (fd == -1) { perror("open"); return 1; }
    if (write(fd, text, strlen(text)) == -1) { perror("write"); return 1; }

    /* fcntl : get the file status flags */
    flags = fcntl(fd, F_GETFL);
    if (flags == -1) { perror("fcntl"); return 1; }
    printf("---- fcntl ----\n");
    if ((flags & O_ACCMODE) == O_RDWR)   printf("File opened in READ-WRITE mode\n");
    else if ((flags & O_ACCMODE) == O_RDONLY) printf("File opened in READ-ONLY mode\n");
    else printf("File opened in WRITE-ONLY mode\n");

    /* lseek : move to position 10 and read 5 bytes */
    printf("\n---- lseek ----\n");
    lseek(fd, 10, SEEK_SET);
    n = read(fd, buf, 5);
    if (n < 0) n = 0;
    buf[n] = '\0';
    printf("5 characters read after seeking to offset 10: %s\n", buf);
    printf("File size using lseek(SEEK_END): %ld bytes\n", (long)lseek(fd, 0, SEEK_END));
    close(fd);

    /* stat : file information */
    printf("\n---- stat ----\n");
    if (stat("test.txt", &st) == -1) { perror("stat"); return 1; }
    printf("File size      : %ld bytes\n", (long)st.st_size);
    printf("Inode number   : %ld\n", (long)st.st_ino);
    printf("Hard links     : %ld\n", (long)st.st_nlink);
    printf("Permissions    : %o (octal)\n", (unsigned)(st.st_mode & 0777));

    /* opendir / readdir : list current directory */
    printf("\n---- opendir / readdir (current directory) ----\n");
    dir = opendir(".");
    if (dir == NULL) { perror("opendir"); return 1; }
    while ((entry = readdir(dir)) != NULL)
        printf("%s\n", entry->d_name);
    closedir(dir);

    unlink("test.txt");
    return 0;
}
