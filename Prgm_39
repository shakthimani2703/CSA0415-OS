/* Q39. C-SCAN (Circular SCAN) disk scheduling
   Head moves toward the higher end servicing requests, jumps to the
   other end (cylinder 0) and continues in the same direction. */
#include <stdio.h>
#include <stdlib.h>

void sort(int a[], int n) {
    int i, j, t;
    for (i = 0; i < n - 1; i++)
        for (j = 0; j < n - i - 1; j++)
            if (a[j] > a[j + 1]) { t = a[j]; a[j] = a[j + 1]; a[j + 1] = t; }
}

int main(void) {
    int n, i, head, size, req[50], total = 0, cur, idx;

    printf("Enter number of requests: ");
    scanf("%d", &n);
    printf("Enter the request queue: ");
    for (i = 0; i < n; i++) scanf("%d", &req[i]);
    printf("Enter initial head position: ");
    scanf("%d", &head);
    printf("Enter disk size (e.g. 200 for cylinders 0-199): ");
    scanf("%d", &size);

    sort(req, n);

    idx = 0;
    while (idx < n && req[idx] < head) idx++;

    cur = head;
    printf("\nSeek sequence: %d", head);

    /* service requests towards the higher end */
    for (i = idx; i < n; i++) {
        total += abs(req[i] - cur); cur = req[i];
        printf(" -> %d", cur);
    }

    if (idx > 0) {
        /* go to the last cylinder, then jump to cylinder 0 */
        total += abs((size - 1) - cur); cur = size - 1;
        printf(" -> %d", cur);
        total += (size - 1);            /* return jump counted as head movement */
        cur = 0;
        printf(" -> %d", cur);

        for (i = 0; i < idx; i++) {
            total += abs(req[i] - cur); cur = req[i];
            printf(" -> %d", cur);
        }
    }

    printf("\n\nTotal head movement (seek time) = %d\n", total);
    printf("Average seek time = %.2f\n", (float)total / n);
    return 0;
}
