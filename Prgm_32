/* Q32. LRU (Least Recently Used) page replacement */
#include <stdio.h>

int main(void) {
    int n, f, i, j, ref[50], frame[10], lastUsed[10];
    int faults = 0, hits = 0, found, pos;

    printf("Enter number of pages in reference string: ");
    scanf("%d", &n);
    printf("Enter the reference string: ");
    for (i = 0; i < n; i++) scanf("%d", &ref[i]);
    printf("Enter number of frames: ");
    scanf("%d", &f);

    for (i = 0; i < f; i++) { frame[i] = -1; lastUsed[i] = -1; }

    printf("\nPage\tFrames\t\tStatus\n");
    for (i = 0; i < n; i++) {
        found = 0;
        for (j = 0; j < f; j++) {
            if (frame[j] == ref[i]) {
                found = 1;
                lastUsed[j] = i;            /* update time of use */
                break;
            }
        }

        if (!found) {
            /* find an empty frame, otherwise the least recently used one */
            pos = 0;
            for (j = 0; j < f; j++) {
                if (frame[j] == -1) { pos = j; break; }
                if (lastUsed[j] < lastUsed[pos]) pos = j;
            }
            frame[pos] = ref[i];
            lastUsed[pos] = i;
            faults++;
        } else {
            hits++;
        }

        printf("%d\t", ref[i]);
        for (j = 0; j < f; j++) {
            if (frame[j] == -1) printf("- ");
            else printf("%d ", frame[j]);
        }
        printf("\t\t%s\n", found ? "Hit" : "Fault");
    }

    printf("\nTotal Page Faults = %d\n", faults);
    printf("Total Page Hits   = %d\n", hits);
    return 0;
}
