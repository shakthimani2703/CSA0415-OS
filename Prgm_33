/* Q33. Optimal page replacement */
#include <stdio.h>

int main(void) {
    int n, f, i, j, k, ref[50], frame[10];
    int faults = 0, hits = 0, found, pos, farthest;

    printf("Enter number of pages in reference string: ");
    scanf("%d", &n);
    printf("Enter the reference string: ");
    for (i = 0; i < n; i++) scanf("%d", &ref[i]);
    printf("Enter number of frames: ");
    scanf("%d", &f);

    for (i = 0; i < f; i++) frame[i] = -1;

    printf("\nPage\tFrames\t\tStatus\n");
    for (i = 0; i < n; i++) {
        found = 0;
        for (j = 0; j < f; j++)
            if (frame[j] == ref[i]) { found = 1; break; }

        if (!found) {
            pos = -1;
            /* use an empty frame first */
            for (j = 0; j < f; j++)
                if (frame[j] == -1) { pos = j; break; }

            /* otherwise replace the page used farthest in future (or never) */
            if (pos == -1) {
                farthest = -1;
                for (j = 0; j < f; j++) {
                    for (k = i + 1; k < n; k++)
                        if (ref[k] == frame[j]) break;
                    if (k > farthest) { farthest = k; pos = j; }
                }
            }
            frame[pos] = ref[i];
            faults++;
        } else {
            hits++;
        }

        printf("%d\t", ref[i]);
        for (j = 0; j < f; j++) {
            if (frame[j] == -1) printf("- ");
            else printf("%d ", frame[j]);
        }
        printf("\t\t%s\n", found ? "Hit" : "Fault");
    }

    printf("\nTotal Page Faults = %d\n", faults);
    printf("Total Page Hits   = %d\n", hits);
    return 0;
}
