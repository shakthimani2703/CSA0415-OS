/* Q23. First Fit memory allocation */
#include <stdio.h>

int main(void) {
    int nb, np, i, j;
    int block[20], blockOrig[20], process[20], alloc[20];

    printf("Enter number of memory blocks: ");
    scanf("%d", &nb);
    printf("Enter size of each block:\n");
    for (i = 0; i < nb; i++) {
        printf("Block %d: ", i + 1);
        scanf("%d", &block[i]);
        blockOrig[i] = block[i];
    }

    printf("Enter number of processes: ");
    scanf("%d", &np);
    printf("Enter size of each process:\n");
    for (i = 0; i < np; i++) {
        printf("Process %d: ", i + 1);
        scanf("%d", &process[i]);
        alloc[i] = -1;
    }

    /* For each process pick the FIRST block that can hold it */
    for (i = 0; i < np; i++) {
        for (j = 0; j < nb; j++) {
            if (block[j] >= process[i]) {
                alloc[i] = j;
                block[j] -= process[i];
                break;
            }
        }
    }

    printf("\nProcess No.\tProcess Size\tBlock No.\tBlock Size\tRemaining\n");
    for (i = 0; i < np; i++) {
        printf("%d\t\t%d\t\t", i + 1, process[i]);
        if (alloc[i] != -1)
            printf("%d\t\t%d\t\t%d\n", alloc[i] + 1, blockOrig[alloc[i]], block[alloc[i]]);
        else
            printf("Not Allocated\n");
    }
    return 0;
}
